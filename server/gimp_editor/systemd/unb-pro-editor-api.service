[Unit]
Description=UNB Pro Editor FastAPI
After=network.target unb-gimp-scriptfu.service
Requires=unb-gimp-scriptfu.service

[Service]
Type=simple
User=unb-editor
Group=unb-editor
WorkingDirectory=/opt/unb-pro-editor/gimp_editor
EnvironmentFile=/etc/unb-pro-editor.env
Environment=HOME=/var/lib/unb-pro-editor
Environment=UNB_EDITOR_DATA=/var/lib/unb-pro-editor
Environment=UNB_GIMP_HOST=127.0.0.1
Environment=UNB_GIMP_PORT=10008
ExecStart=/opt/unb-pro-editor/gimp_editor/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 18083
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/unb-pro-editor /opt/unb-pro-editor/gimp_editor

[Install]
WantedBy=multi-user.target
